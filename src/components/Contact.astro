<section id="contacto" class="contact section-padding">
  <div class="container">
    <div class="section-header text-center fade-in">
      <span class="section-subtitle">Contacto</span>
      <h2 class="section-title">
        Solicitar <span class="text-accent">Consulta</span>
      </h2>
      <p class="section-description">
        Complete el formulario y me pondré en contacto con usted dentro de 24 horas.
      </p>
    </div>

    <div class="contact-grid">
      <div class="contact-info fade-in">
        <div class="info-header">
          <h3>Información de Contacto</h3>
          <p>Disponible para atender sus consultas y brindarle la mejor asesoría legal personalizada.</p>
        </div>

        <div class="contact-item">
          <div class="contact-icon">
            <i class="fas fa-map-marker-alt"></i>
          </div>
          <div class="contact-details">
            <h4>Dirección</h4>
            <p>Valdivia #300<br>Los Ángeles, Chile<br>Oficina 515, Edificio Plaza Fundación </p>
          </div>
        </div>

        <div class="contact-item">
          <div class="contact-icon">
            <i class="fas fa-phone"></i>
          </div>
          <div class="contact-details">
            <h4>Teléfono</h4>
            <p>+56 (9) XXXXXXXX<br>+56 (9) XXXXXXXX</p>
          </div>
        </div>

        <div class="contact-item">
          <div class="contact-icon">
            <i class="fas fa-envelope"></i>
          </div>
          <div class="contact-details">
            <h4>Email</h4>
            <p>info@abogadosfl.cl<br>consultas@abogadosfl.cl</p>
          </div>
        </div>

        <div class="contact-item">
          <div class="contact-icon">
            <i class="fas fa-clock"></i>
          </div>
          <div class="contact-details">
            <h4>Horario de Atención</h4>
            <p>Lunes a Viernes: 8:00 AM - 6:00 PM<br>Sábados: 9:00 AM - 2:00 PM</p>
          </div>
        </div>

        <div class="emergency-contact">
          <h4><i class="fas fa-exclamation-triangle"></i> Emergencias 24/7</h4>
          <p>Para casos urgentes: <strong>+56 (9) XXXXXXXX</strong></p>
        </div>
      </div>

      <div class="contact-form-container fade-in">
        <div class="form-header">
          <h3>Solicitar Consulta</h3>
          <p>Complete el formulario y me pondré en contacto con usted dentro de 24 horas.</p>
        </div>

        <form class="contact-form" id="contactForm" action="/enviar_correo.php" method="POST">
          <div class="form-row">
            <div class="form-group">
              <label for="nombre">Nombre Completo *</label>
              <input 
                type="text" 
                id="nombre" 
                name="nombre" 
                required 
                placeholder="Ingrese su nombre completo"
              />
            </div>

            <div class="form-group">
              <label for="email">Email *</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="correo@ejemplo.com"
              />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="telefono">Teléfono *</label>
              <input 
                type="tel" 
                id="telefono" 
                name="telefono" 
                required 
                placeholder="+56 9 XXXX XXXX"
              />
            </div>

            <div class="form-group">
              <label for="servicio">Área Legal de Interés *</label>
              <select id="servicio" name="servicio" required>
                <option value="">Seleccione un servicio</option>
                <option value="derecho-corporativo">Derecho Corporativo</option>
                <option value="derecho-inmobiliario">Derecho Inmobiliario</option>
                <option value="derecho-familia">Derecho de Familia</option>
                <option value="derecho-laboral">Derecho Laboral</option>
                <option value="derecho-penal">Derecho Penal</option>
                <option value="derecho-civil">Derecho Civil</option>
                <option value="otro">Otro</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="mensaje">Descripción del Caso *</label>
            <textarea 
              id="mensaje" 
              name="mensaje" 
              rows="5" 
              required 
              placeholder="Describa brevemente su situación legal y cómo podemos ayudarle..."
            ></textarea>
          </div>

          <div class="form-group checkbox-group">
            <label class="checkbox-label">
              <input type="checkbox" id="politicas" name="politicas" required />
              <span class="checkmark"></span>
              He leído y acepto la <a href="/politica-privacidad" target="_blank">Política de Privacidad</a> y el <a href="/terminos-condiciones" target="_blank">Tratamiento de Datos</a>
            </label>
          </div>

          <div class="g-recaptcha" data-sitekey="TU_CLAVE_DEL_SITIO"></div>

          <button type="submit" class="btn btn-primary btn-lg contact-submit">
            <span class="btn-text">Enviar Consulta</span>
            <span class="btn-loader" style="display: none;">
              <i class="fas fa-spinner fa-spin"></i>
            </span>
          </button>

          <p class="form-note">
            * Campos obligatorios. Su información será tratada de manera confidencial.
          </p>
        </form>
      </div>
    </div>
  </div>

  <div class="map-section section-padding">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-subtitle">UBICACIÓN</span>
        <h2 class="section-title">¿Dónde <span class="text-accent">Encontrarnos</span>?</h2>
        <p class="section-description">Visítenos en nuestra oficina en el centro de Los Ángeles</p>
      </div>

      <div class="map-wrapper">
        <div class="map-container">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1234.5678901234567!2d-72.12345678901234!3d-37.12345678901234!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMznCsDEyJzM0LjUiUyA3MsKwMTInMzQuNSJX!5e0!3m2!1ses!2scl!4v1234567890123!5m2!1ses!2scl"
            width="100%"
            height="450"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
      </div>

      <div class="location-details">
        <div class="location-item">
          <div class="location-icon">
            <i class="fas fa-map-marker-alt"></i>
          </div>
          <h4 class="location-title">Dirección</h4>
          <p class="location-text">
            Valdivia #300<br>
            Oficina 515, Edificio Plaza Fundación<br>
            Los Ángeles, Chile
          </p>
        </div>

        <div class="location-item">
          <div class="location-icon">
            <i class="fas fa-clock"></i>
          </div>
          <h4 class="location-title">Horario de Atención</h4>
          <p class="location-text">
            Lunes a Viernes: 8:00 AM - 6:00 PM<br>
            Sábados: 9:00 AM - 2:00 PM<br>
            Domingos: Cerrado
          </p>
        </div>

        <div class="location-item">
          <div class="location-icon">
            <i class="fas fa-phone-alt"></i>
          </div>
          <h4 class="location-title">Teléfonos</h4>
          <p class="location-text">
            +56 (9) XXXXXXXX<br>
            +56 (9) XXXXXXXX
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     Estilos de la Sección de Contacto
     ========================================================================== */
  .contact {
    background-color: var(--color-white);
    position: relative;
    overflow: hidden;
  }

  .contact::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('/images/pattern-light.png');
    background-size: cover;
    opacity: 0.03;
    pointer-events: none;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    margin-top: 4rem;
    position: relative;
  }

  /* Columna de Información */
  .contact-info {
    padding: 3rem;
    background-color: var(--color-primary);
    color: var(--color-white);
    position: relative;
  }

  .contact-info::before {
    content: '';
    position: absolute;
    inset: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    pointer-events: none;
  }

  .contact-info h3 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: var(--color-white);
    position: relative;
    padding-bottom: 1.5rem;
  }

  .contact-info h3::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 60px;
    height: 2px;
    background-color: var(--color-accent);
  }

  .contact-info > p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: 3rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 2.5rem;
    padding-left: 1rem;
    position: relative;
  }

  .contact-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: 100%;
    background-color: var(--color-accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.3s ease;
  }

  .contact-item:hover::before {
    transform: scaleY(1);
  }

  .contact-icon {
    color: var(--color-accent);
    font-size: 1.75rem;
    transition: transform 0.3s ease;
  }

  .contact-item:hover .contact-icon {
    transform: scale(1.1);
  }

  .contact-details h4 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    color: var(--color-white);
    font-weight: 600;
  }

  .contact-details p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.85);
  }

  .emergency-contact {
    margin-top: 3rem;
    padding: 2rem;
    background-color: rgba(255, 255, 255, 0.05);
    border-left: none;
    position: relative;
  }

  .emergency-contact::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 4px;
    height: 100%;
    background-color: var(--color-accent);
  }

  .emergency-contact h4 {
    font-size: 1.25rem;
    color: var(--color-white);
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .emergency-contact i {
    color: var(--color-accent);
  }

  .emergency-contact p {
    margin: 0;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Contenedor del Formulario */
  .contact-form-container {
    background: var(--color-white);
    padding: 4rem;
    position: relative;
    box-shadow: var(--shadow-lg);
  }

  .form-header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .form-header h3 {
    font-size: 2.25rem;
    color: var(--color-primary);
    margin-bottom: 1rem;
    position: relative;
    padding-bottom: 1.5rem;
  }

  .form-header h3::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 2px;
    background-color: var(--color-accent);
  }

  .form-header p {
    font-size: 1.125rem;
    color: var(--color-text);
    line-height: 1.8;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .form-group {
    margin-bottom: 0;
  }

  label {
    display: block;
    font-weight: 500;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
    font-size: 1rem;
  }

  input, select, textarea {
    width: 100%;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-white);
    color: var(--color-text);
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  input:focus, select:focus, textarea:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(197, 164, 126, 0.1);
    outline: none;
  }

  textarea {
    min-height: 150px;
    resize: vertical;
  }

  .checkbox-group {
    margin: 2rem 0;
  }

  .checkbox-label {
    font-size: 0.9375rem;
    color: var(--color-text);
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    cursor: pointer;
  }

  .checkbox-label input {
    width: 20px;
    height: 20px;
    margin-top: 0.2rem;
    border: 2px solid var(--color-border);
    border-radius: 4px;
    appearance: none;
    cursor: pointer;
    position: relative;
    transition: all 0.3s ease;
  }

  .checkbox-label input:checked {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .checkbox-label input:checked::after {
    content: '✓';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--color-white);
    font-size: 0.875rem;
  }

  .checkbox-label a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .checkbox-label a:hover {
    color: var(--color-primary);
  }

  .contact-submit {
    width: 100%;
    padding: 1.25rem;
    font-size: 1rem;
    letter-spacing: 1px;
    margin-top: 2rem;
    position: relative;
    overflow: hidden;
  }

  .contact-submit::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 120%;
    height: 120%;
    background: rgba(255, 255, 255, 0.1);
    transform: translate(-50%, -50%) rotate(45deg) translateY(100%);
    transition: transform 0.6s ease;
  }

  .contact-submit:hover::before {
    transform: translate(-50%, -50%) rotate(45deg) translateY(-100%);
  }

  .map-section {
    padding-top: 6rem;
    padding-bottom: 6rem;
    background: var(--color-white);
    position: relative;
  }

  .map-container {
    height: 500px;
    margin-top: 4rem;
    position: relative;
    overflow: hidden;
  }

  .map-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.1);
    pointer-events: none;
    z-index: 1;
  }

  .location-details {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 4rem;
  }

  .location-item {
    text-align: center;
  }

  .location-icon {
    font-size: 2rem;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }

  .location-title {
    font-size: 1.375rem;
    color: var(--color-primary);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .location-text {
    font-size: 1.125rem;
    color: var(--color-text);
    line-height: 1.8;
  }

  /* Media Query para Tablet */
  @media (min-width: 768px) {
    .form-row {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }

    .contact-form-container {
      padding: 4rem;
    }

    .location-details {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  /* Media Query para Desktop */
  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: 450px 1fr;
      gap: 6rem;
    }

    .contact-info {
      padding: 4rem;
    }

    .form-header h3 {
      font-size: 2.5rem;
    }

    .form-header p {
      font-size: 1.25rem;
    }

    .map-container {
      height: 600px;
    }

    .location-title {
      font-size: 1.5rem;
    }
  }

  /* Media Query para pantallas grandes */
  @media (min-width: 1280px) {
    .contact-grid {
      gap: 8rem;
    }

    .contact-info {
      padding: 5rem;
    }

    .contact-form-container {
      padding: 5rem;
    }

    .map-section {
      padding-top: 8rem;
      padding-bottom: 8rem;
    }
  }
</style>

<script src="../utils/contact-form.js"></script>