---
// Services Component - Areas de Práctica
const services = [
  {
    icon: 'fas fa-building',
    title: 'Derecho Corporativo',
    description: 'Asesoría integral para empresas, contratos comerciales, fusiones y adquisiciones.',
    bgColor: 'primary'
  },
  {
    icon: 'fas fa-home',
    title: 'Derecho Inmobiliario',
    description: 'Compraventa, arrendamientos, propiedad horizontal y regulación urbana.',
    bgColor: 'accent'
  },
  {
    icon: 'fas fa-heart',
    title: 'Derecho de Familia',
    description: 'Divorcios, custodia, pensiones alimentarias y adopciones con sensibilidad.',
    bgColor: 'primary'
  },
  {
    icon: 'fas fa-briefcase',
    title: 'Derecho Laboral',
    description: 'Defensa de trabajadores y empleadores en conflictos laborales.',
    bgColor: 'accent'
  },
  {
    icon: 'fas fa-shield-alt',
    title: 'Derecho Penal',
    description: 'Defensa penal especializada con amplia experiencia en tribunales.',
    bgColor: 'primary'
  },
  {
    icon: 'fas fa-file-contract',
    title: 'Derecho Civil',
    description: 'Contratos, responsabilidad civil, sucesiones y derechos reales.',
    bgColor: 'accent'
  }
];
---

<section id="servicios" class="services section-padding">
  <div class="container">
    <div class="section-header text-center fade-in">
      <span class="section-subtitle">Nuestros Servicios</span>
      <h2 class="section-title">
        Áreas de <span class="text-accent">Práctica Legal</span>
      </h2>
      <p class="section-description">
        Ofrecemos servicios legales especializados en múltiples áreas del derecho, 
        brindando soluciones integrales para individuos y empresas.
      </p>
    </div>
    
    <div class="services-grid">
      {services.map((service, index) => (
        <div class={`service-card service-card--${service.bgColor} fade-in`}>
          <div class="service-icon">
            <i class={service.icon}></i>
          </div>
          <h3 class="service-title">{service.title}</h3>
          <p class="service-description">{service.description}</p>
          <a href="#contacto" class="service-link">
            Consultar <i class="fas fa-arrow-right"></i>
          </a>
        </div>
      ))}
    </div>
    
    <div class="services-cta text-center fade-in">
      <h3>¿No encuentra el servicio que necesita?</h3>
      <p>Contáctenos para discutir su caso específico</p>
      <a href="#contacto" class="btn btn-primary btn-lg">Consulta Personalizada</a>
    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     Estilos de la Sección de Servicios
     ========================================================================== */
  .services {
    background-color: var(--color-white);
    position: relative;
    overflow: hidden;
  }

  .services::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('/images/pattern-light.png');
    background-size: cover;
    opacity: 0.03;
    pointer-events: none;
  }
  
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin: 4rem 0;
    position: relative;
  }
  
  .service-card {
    padding: 3rem 2rem;
    background-color: var(--color-primary);
    text-align: center;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
    color: var(--color-white);
    border: none;
  }
  
  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }
  
  .service-card > * {
    position: relative;
    z-index: 1;
  }

  .service-card--primary {
    background-color: var(--color-primary);
  }
  
  .service-card--accent {
    background-color: var(--color-accent);
  }
  
  .service-icon {
    width: 70px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 2rem;
    transition: all 0.4s ease;
    position: relative;
  }
  
  .service-card--primary .service-icon {
    color: var(--color-accent);
  }

  .service-card--accent .service-icon {
    color: var(--color-primary);
  }
  
  .service-icon i {
    font-size: 2.5rem;
    transition: transform 0.4s ease;
  }
  
  .service-title {
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
    color: var(--color-white);
    font-weight: 600;
    letter-spacing: 0.5px;
  }
  
  .service-description {
    font-size: 1rem;
    line-height: 1.8;
    margin-bottom: 2rem;
    color: rgba(255, 255, 255, 0.85);
  }
  
  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-white);
    font-weight: 500;
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.4s ease;
  }

  .service-link i {
    font-size: 0.875rem;
    transition: transform 0.4s ease;
  }
  
  .services-cta {
    background-color: var(--color-primary);
    padding: 4rem 2rem;
    margin-top: 3rem;
    position: relative;
    color: var(--color-white);
  }
  
  .services-cta h3 {
    color: var(--color-white);
    font-size: 2rem;
    margin-bottom: 1rem;
    font-weight: 600;
  }
  
  .services-cta p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.125rem;
    margin-bottom: 2.5rem;
    line-height: 1.8;
  }

  /* Hover states */
  .service-card:hover {
    transform: translateY(-8px);
  }

  .service-card:hover::before {
    transform: scaleX(1);
  }

  .service-card:hover .service-icon i {
    transform: scale(1.15) rotate(360deg);
  }

  .service-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .service-link:hover i {
    transform: translateX(5px);
  }

  /* Media Query para Tablet */
  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
      margin: 5rem 0;
    }

    .service-card {
      padding: 3.5rem 2.5rem;
    }

    .service-title {
      font-size: 1.75rem;
    }

    .services-cta {
      padding: 5rem 3rem;
      margin-top: 4rem;
    }

    .services-cta h3 {
      font-size: 2.25rem;
    }

    .services-cta p {
      font-size: 1.25rem;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  /* Media Query para Desktop */
  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
      margin: 6rem 0;
    }

    .service-card {
      padding: 4rem 3rem;
    }

    .service-icon {
      margin-bottom: 2.5rem;
    }

    .service-title {
      font-size: 1.875rem;
    }

    .services-cta {
      padding: 6rem 4rem;
      margin-top: 5rem;
    }

    .services-cta h3 {
      font-size: 2.5rem;
    }
  }

  /* Media Query para pantallas grandes */
  @media (min-width: 1280px) {
    .services-grid {
      gap: 3rem;
    }

    .service-card {
      padding: 4.5rem 3.5rem;
    }
  }
</style>
