---
interface Lawyer {
  name: string;
  title: string;
  image: string;
  description: string;
  specialties: string[];
  social: {
    linkedin: string;
    email: string;
  };
}

const lawyers: Lawyer[] = [
  {
    name: "Dr. Patolo Francisco",
    title: "Socio Fundador, Experto en Derecho Corporativo",
    image: "/images/abogado1.png",
    description: "Con más de 15 años de experiencia, el Dr. Francisco lidera el bufete con una profunda experiencia en fusiones, adquisiciones y litigios comerciales complejos.",
    specialties: ["Derecho Corporativo", "Fusiones y Adquisiciones", "Litigios Comerciales"],
    social: {
      linkedin: "https://www.linkedin.com/in/dr-patolo-francisco",
      email: "dr.patolo.francisco@example.com"
    },
  }
];
---

<section id="abogado" class="lawyer section-padding">
  <div class="container">
    <div class="section-header text-center fade-in">
      <span class="section-subtitle">Perfil Profesional</span>
      <h2 class="section-title">
        Experiencia y <span class="text-accent">Compromiso</span>
      </h2>
      <p class="section-description">
        Dedicado a brindar asesoría legal de excelencia, combinando experiencia práctica 
        con un profundo conocimiento del derecho y un compromiso inquebrantable con mis clientes.
      </p>
    </div>
    
    <div class="lawyer-profile fade-in">
      <div class="lawyer-image">
        <img src={lawyers[0].image} alt={lawyers[0].name} />
        <div class="lawyer-social">
          <a href={lawyers[0].social.linkedin} class="social-link" aria-label="LinkedIn">
            <i class="fab fa-linkedin-in"></i>
          </a>
          <a href={`mailto:${lawyers[0].social.email}`} class="social-link" aria-label="Email">
            <i class="fas fa-envelope"></i>
          </a>
        </div>
      </div>
      
      <div class="lawyer-content">
        <div class="lawyer-header">
          <h3 class="lawyer-name">{lawyers[0].name}</h3>
          <p class="lawyer-title">{lawyers[0].title}</p>
        </div>

        <p class="lawyer-bio">{lawyers[0].description}</p>
        
        <div class="lawyer-specialties">
          <h4>Áreas de Práctica</h4>
          <div class="specialty-tags">
            {lawyers[0].specialties.map((specialty) => (
              <span class="specialty-tag">{specialty}</span>
            ))}
          </div>
        </div>
        
        <div class="lawyer-details">
          <!-- <div class="detail-group">
            <h4>Educación</h4>
            <ul>
              {lawyers[0].education.map((edu) => (
                <li>{edu}</li>
              ))}
            </ul>
          </div>
          
          <div class="detail-group">
            <h4>Reconocimientos</h4>
            <ul> -->
              <!-- {lawyers[0].awards.map((award) => (
                <li>{award}</li>
              ))} -->
            <!-- </ul>
          </div> -->
        </div>
      </div>
    </div>
    
    <div class="lawyer-cta text-center fade-in">
      <h3>¿Necesita asesoría legal especializada?</h3>
      <p>Estoy aquí para ayudarle con su caso</p>
      <a href="#contacto" class="btn btn-primary btn-lg">Agendar Consulta</a>
    </div>
  </div>
</section>

<section class="team section-padding">
  <div class="container">
    <div class="section-header text-center fade-in">
      <span class="section-subtitle">Nosotros</span>
      <h2 class="section-title">
        Abogado con <span class="text-accent">Experiencia</span>
      </h2>
      <p class="section-description">
        Conozca a Francisco Patolo, profesional dedicado a brindar la mejor defensa y asesoría legal.
      </p>
    </div>
    
    <div class="team-grid">
      {lawyers.map((lawyer: Lawyer) => (
        <div class="team-member fade-in">
          <div class="member-image">
            <img src={lawyer.image} alt={`Retrato de ${lawyer.name}, ${lawyer.title}`} />
          </div>
          <div class="member-info">
            <h3 class="member-name">{lawyer.name}</h3>
            <p class="member-title">{lawyer.title}</p>
            <div class="member-specialties">
              {lawyer.specialties.map((specialty: string) => (
                <span class="specialty-tag">{specialty}</span>
              ))}
            </div>
            <div class="member-contact">
              <a href={`mailto:${lawyer.social.email}`} class="btn btn-primary btn-sm">
                Contactar
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Estilos generales de la sección */
  .lawyer {
    background-color: var(--color-white);
    position: relative;
    overflow: hidden;
  }

  .lawyer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('/images/pattern-light.png');
    background-size: cover;
    opacity: 0.03;
    pointer-events: none;
  }
  
  .section-header {
    max-width: 750px;
    margin: 0 auto 5rem;
    text-align: center;
    position: relative;
  }
  
  .section-subtitle {
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }
  
  .lawyer-profile {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto 5rem;
    position: relative;
  }
  
  .lawyer-image {
    position: relative;
  }
  
  .lawyer-image img {
    width: 100%;
    height: auto;
    position: relative;
    z-index: 2;
  }

  .lawyer-image::before {
    content: '';
    position: absolute;
    top: -2rem;
    right: -2rem;
    width: 100%;
    height: 100%;
    border: 2px solid var(--color-accent);
    z-index: 1;
  }
  
  .lawyer-social {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    display: flex;
    gap: 1rem;
    z-index: 3;
  }
  
  .social-link {
    width: 45px;
    height: 45px;
    background-color: var(--color-primary);
    color: var(--color-white);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .social-link::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--color-accent);
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }

  .social-link i {
    position: relative;
    z-index: 1;
    font-size: 1.125rem;
  }

  .social-link:hover::before {
    transform: translateY(0);
  }
  
  .lawyer-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  
  .lawyer-header {
    margin-bottom: 1rem;
    position: relative;
    padding-bottom: 2rem;
  }

  .lawyer-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 60px;
    height: 2px;
    background-color: var(--color-accent);
  }
  
  .lawyer-name {
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }
  
  .lawyer-title {
    font-size: 1.25rem;
    color: var(--color-accent);
    font-weight: 500;
    font-family: var(--font-heading);
  }
  
  .lawyer-bio {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text);
  }
  
  .lawyer-specialties {
    margin-top: 2rem;
  }
  
  .lawyer-specialties h4 {
    font-size: 1.25rem;
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: 1.5rem;
  }
  
  .specialty-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  .specialty-tag {
    background-color: var(--color-primary);
    color: var(--color-white);
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    border: 2px solid var(--color-primary);
  }

  .specialty-tag:hover {
    background-color: transparent;
    color: var(--color-primary);
  }
  
  .lawyer-details {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-border);
  }
  
  .detail-group h4 {
    font-size: 1.25rem;
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: 1.5rem;
    position: relative;
    padding-left: 1.5rem;
  }

  .detail-group h4::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 20px;
    background-color: var(--color-accent);
  }
  
  .detail-group ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .detail-group ul li {
    font-size: 1.125rem;
    color: var(--color-text);
    line-height: 1.6;
    padding-left: 1.5rem;
    position: relative;
  }

  .detail-group ul li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }
  
  .lawyer-cta {
    max-width: 800px;
    margin: 6rem auto 0;
    text-align: center;
    background-color: var(--color-primary);
    padding: 4rem;
    color: var(--color-white);
    position: relative;
  }

  .lawyer-cta::before {
    content: '';
    position: absolute;
    inset: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    pointer-events: none;
  }
  
  .lawyer-cta h3 {
    font-size: 2.25rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--color-white);
  }
  
  .lawyer-cta p {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .lawyer-cta .btn {
    min-width: 200px;
  }
  
  .section-title {
    @apply text-4xl font-bold mb-4;
    color: var(--color-primary);
    margin: 0.5rem 0 1rem;
  }
  
  .section-description {
    font-size: 1.1rem;
    color: var(--color-text-light);
    line-height: 1.6;
  }
  
  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }
  
  .team-card {
    background-color: var(--color-white);
    border-radius: 15px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: all 0.3s ease;
  }
  
  .team-card:hover {
    transform: translateY(-10px);
    box-shadow: var(--shadow-hover);
  }
  
  .team-image {
    position: relative;
    overflow: hidden;
    height: 280px;
  }
  
  .team-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  
  .team-card:hover .team-image img {
    transform: scale(1.1);
  }
  
  .team-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to bottom, transparent 0%, rgba(31, 44, 61, 0.8) 100%);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .team-card:hover .team-overlay {
    opacity: 1;
  }
  
  .team-social {
    display: flex;
    gap: 1rem;
  }
  
  .social-link {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--color-accent);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  
  .social-link:hover {
    background-color: var(--color-white);
    color: var(--color-accent);
    transform: translateY(-3px);
  }
  
  .team-content {
    padding: 2rem;
    text-align: center;
  }
  
  .team-name {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
    font-family: var(--font-heading);
  }
  
  .team-position {
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  
  .team-specialty {
    color: var(--color-text-light);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
  
  .team-details {
    margin-bottom: 1.5rem;
    text-align: left;
  }
  
  .team-detail {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }
  
  .detail-label {
    color: var(--color-text-light);
    font-weight: 500;
  }
  
  .detail-value {
    color: var(--color-text);
    font-weight: 600;
  }
  
  .team-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    padding: 0.5rem 1rem;
    border-radius: 25px;
    border: 2px solid var(--color-accent);
  }
  
  .team-contact:hover {
    background-color: var(--color-accent);
    color: var(--color-white);
    transform: translateX(5px);
  }
  
  .team-cta {
    background-color: var(--color-white);
    padding: 3rem 2rem;
    border-radius: 15px;
    box-shadow: var(--shadow-card);
  }
  
  .team-cta h3 {
    color: var(--color-primary);
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }
  
  .team-cta p {
    color: var(--color-text-light);
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }
  
  /* Media Query para Tablet */
  @media (min-width: 768px) {
    .lawyer-details {
      grid-template-columns: repeat(2, 1fr);
      gap: 4rem;
    }

    .specialty-tags {
      gap: 1.25rem;
    }

    .lawyer-cta {
      padding: 5rem;
    }

    .lawyer-cta h3 {
      font-size: 2.5rem;
    }
  }

  /* Media Query para Desktop */
  @media (min-width: 1024px) {
    .lawyer-profile {
      grid-template-columns: repeat(2, 1fr);
      gap: 6rem;
    }

    .lawyer-content {
      gap: 3rem;
    }

    .lawyer-name {
      font-size: 3rem;
    }

    .lawyer-title {
      font-size: 1.375rem;
    }

    .lawyer-bio {
      font-size: 1.25rem;
    }

    .lawyer-specialties h4,
    .detail-group h4 {
      font-size: 1.5rem;
    }

    .specialty-tag {
      font-size: 1rem;
    }
  }

  /* Media Query para pantallas grandes */
  @media (min-width: 1280px) {
    .lawyer-profile {
      gap: 8rem;
    }

    .lawyer-cta {
      padding: 6rem;
      margin-top: 8rem;
    }

    .lawyer-cta h3 {
      font-size: 3rem;
    }

    .lawyer-cta p {
      font-size: 1.375rem;
    }
  }
</style>
