---
// Hero Section Component - Mejorado y responsivo
---

<section id="inicio" class="hero">
  <!-- Video Background Optimizado -->
  <video 
    class="hero-video"
    autoplay 
    muted 
    loop 
    playsinline
    preload="auto"
    style="position: absolute !important; top: 0 !important; left: 0 !important; width: 100% !important; height: 100% !important; min-width: 100% !important; min-height: 100% !important; max-width: none !important; max-height: none !important; object-fit: cover !important; display: block !important;"
  >
    <source src="/videos/Timelapse_edificio.mp4" type="video/mp4">
  </video>
  
  <!-- Overlays para legibilidad y estética -->
  <div class="hero-overlay"></div>
  <div class="hero-pattern"></div>
  
  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title fade-in">
        Defendemos sus Derechos con
        <span class="text-accent">Excelencia y Dedicación</span>
      </h1>
      <p class="hero-subtitle fade-in">
        Brindamos asesoría legal de primera calidad. 
        Nuestro compromiso es proteger sus intereses con la máxima profesionalidad.
      </p>
      <div class="hero-actions fade-in">
        <a href="#contacto" class="btn btn-primary btn-lg">
          <span>Consulta Gratis</span>
          <i class="fas fa-arrow-right"></i>
        </a>
        <a href="#sobre-nosotros" class="btn btn-outline btn-lg">
          <span>Conoce Más</span>
          <i class="fas fa-chevron-down"></i>
        </a>
      </div>
      
      <div class="hero-stats fade-in">
        <div class="stat-item">
          <div class="stat-icon">
            <i class="fas fa-gavel"></i>
          </div>
          <div class="stat-number" data-target="100" data-suffix="+">0</div>
          <div class="stat-label">Casos Exitosos</div>
        </div>
        <div class="stat-item">
          <div class="stat-icon">
            <i class="fas fa-calendar-check"></i>
          </div>
          <div class="stat-number" data-target="5" data-suffix="+">0</div>
          <div class="stat-label">Años de Experiencia</div>
        </div>
        <div class="stat-item">
          <div class="stat-icon">
            <i class="fas fa-trophy"></i>
          </div>
          <div class="stat-number" data-target="98" data-suffix="%">0</div>
          <div class="stat-label">Casos Ganados</div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="scroll-indicator">
    <span>Desliza para ver más</span>
    <i class="fas fa-chevron-down"></i>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding-top: 100px;
    background: #1f2c3d;
  }
  
  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    filter: brightness(0.65);
  }
  
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg, 
      rgba(31, 44, 61, 0.5) 0%, 
      rgba(31, 44, 61, 0.4) 50%, 
      rgba(197, 164, 126, 0.2) 100%
    );
    z-index: 2;
  }
  
  .hero-pattern {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      radial-gradient(circle at 20% 50%, rgba(197, 164, 126, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(197, 164, 126, 0.08) 0%, transparent 50%);
    z-index: 3;
  }
  
  .hero-content {
    text-align: center;
    color: var(--color-white);
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 10;
    padding: 2rem 0 8rem;
  }
  
  .hero-title {
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 700;
    margin-bottom: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.5px;
    animation: fadeInUp 0.8s ease-out;
    color: var(--color-white);
  }
  
  .text-accent {
    color: var(--color-accent);
    display: inline-block;
    position: relative;
  }
  
  .text-accent::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-light));
    opacity: 0.5;
  }
  
  .hero-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    margin-bottom: 2.5rem;
    opacity: 0.95;
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.7;
    font-weight: 300;
    animation: fadeInUp 0.8s ease-out 0.2s backwards;
  }
  
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 4rem;
    flex-wrap: wrap;
    animation: fadeInUp 0.8s ease-out 0.4s backwards;
  }
  
  .hero-actions .btn {
    gap: 0.5rem;
    box-shadow: var(--shadow-xl);
  }
  
  .hero-actions .btn i {
    transition: transform var(--transition-base);
  }
  
  .hero-actions .btn:hover i {
    transform: translateX(4px);
  }
  
  .hero-actions .btn-outline:hover i {
    transform: translateY(4px);
  }
  
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 700px;
    margin: 0 auto;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: var(--radius-xl);
    border: 1px solid rgba(255, 255, 255, 0.1);
    animation: fadeInUp 0.8s ease-out 0.6s backwards;
  }
  
  .stat-item {
    text-align: center;
    padding: 1rem 0.5rem;
    transition: transform var(--transition-base);
  }
  
  .stat-item:hover {
    transform: translateY(-5px);
  }
  
  .stat-icon {
    font-size: 2rem;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
    opacity: 0.9;
  }
  
  .stat-number {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-accent);
    font-family: var(--font-heading);
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  
  .stat-label {
    font-size: clamp(0.8rem, 1.5vw, 0.95rem);
    opacity: 0.85;
    margin-top: 0.5rem;
    font-weight: 400;
  }
  
  .scroll-indicator {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: var(--color-white);
    opacity: 0.7;
    animation: bounce 2s infinite;
    z-index: 10;
    cursor: pointer;
  }
  
  .scroll-indicator span {
    display: block;
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 500;
  }
  
  .scroll-indicator i {
    font-size: 1.5rem;
  }
  
  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
      transform: translateX(-50%) translateY(0);
    }
    40% {
      transform: translateX(-50%) translateY(-10px);
    }
    60% {
      transform: translateX(-50%) translateY(-5px);
    }
  }
  
  /* Tablets */
  @media (max-width: 1024px) {
    .hero-video {
      filter: brightness(0.6);
    }
    
    .hero-stats {
      gap: 1.5rem;
      padding: 1.5rem;
    }
    
    .stat-item {
      padding: 0.75rem 0.25rem;
    }
  }
  
  @media (max-width: 768px) {
    .hero {
      min-height: 100svh;
    }
    
    /* Video más oscuro en móvil para mejor legibilidad */
    .hero-video {
      filter: brightness(0.5);
    }
    
    .hero-content {
      padding: 1rem 0;
    }
    
    .hero-title {
      font-size: 2.5rem;
    }
    
    .hero-subtitle {
      font-size: 1.1rem;
      margin-bottom: 2rem;
    }
    
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      margin-bottom: 3rem;
    }
    
    .hero-actions .btn {
      width: 100%;
      max-width: none;
    }
    
    .hero-stats {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding: 1.5rem 1rem;
      margin: 0 1rem 5rem;
    }
    
    .stat-item {
      padding: 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    
    .stat-item:last-child {
      border-bottom: none;
    }
    
    .stat-icon {
      font-size: 1.75rem;
      margin-bottom: 0.5rem;
    }
    
    .stat-number {
      font-size: 2rem;
    }
    
    .scroll-indicator {
      bottom: 2rem;
    }
    
    .scroll-indicator span {
      font-size: 0.75rem;
    }
  }
  
  @media (max-width: 480px) {
    .hero-title {
      font-size: 2rem;
      margin-bottom: 1rem;
    }
    
    .hero-content {
      padding: 60px 0 8rem;
    }
    
    .hero-subtitle {
      margin-bottom: 1.5rem;
    }
    
    .hero-stats {
      margin: 0 0.5rem;
    }
  }
  
  /* Modo landscape en móviles */
  @media (max-height: 600px) and (orientation: landscape) {
    .hero {
      min-height: auto;
      padding: 6rem 0 3rem;
    }
    
    .hero-stats {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    
    .scroll-indicator {
      display: none;
    }
  }
  
  /* Accesibilidad: Respetar preferencia de movimiento reducido */
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
    
    .hero-video-container::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: url('/images/hero-bg.svg') center/cover;
      filter: brightness(0.6);
    }
  }
</style>

<script>
  // Animación de contadores mejorada
  function animateCounters() {
    const counters = document.querySelectorAll('.stat-number[data-target]');
    
    counters.forEach(counter => {
      const target = parseInt(counter.getAttribute('data-target') || '0');
      const suffix = counter.getAttribute('data-suffix') || '';
      const duration = 2000;
      const start = 0;
      const increment = target / (duration / 16);
      let current = start;
      
      const updateCounter = () => {
        current += increment;
        if (current < target) {
          counter.textContent = Math.floor(current).toString() + suffix;
          requestAnimationFrame(updateCounter);
        } else {
          counter.textContent = target.toString() + suffix;
        }
      };
      
      updateCounter();
    });
  }
  
  // Iniciar animación cuando la sección sea visible
  const heroSection = document.querySelector('.hero');
  if (heroSection) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          setTimeout(animateCounters, 600);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });
    
    observer.observe(heroSection);
  }
  
  // Scroll suave al hacer click en el indicador
  const scrollIndicator = document.querySelector('.scroll-indicator');
  scrollIndicator?.addEventListener('click', () => {
    const nextSection = document.getElementById('sobre-nosotros');
    if (nextSection) {
      nextSection.scrollIntoView({ behavior: 'smooth' });
    }
  });
  
  // ===== OPTIMIZACIÓN DE VIDEO =====
  const heroVideo = document.querySelector('.hero-video') as HTMLVideoElement | null;
  
  console.log('🎥 Video element:', heroVideo);
  console.log('🎥 Video source:', heroVideo?.src);
  console.log('🎥 Video readyState:', heroVideo?.readyState);
  
  if (heroVideo) {
    // Intentar reproducir inmediatamente
    heroVideo.play()
      .then(() => {
        console.log('✅ Video playing successfully');
      })
      .catch(err => {
        console.error('❌ Video autoplay prevented:', err);
        // Intentar reproducir en cualquier interacción del usuario
        document.addEventListener('click', () => {
          heroVideo.play().then(() => {
            console.log('✅ Video playing after user interaction');
          }).catch(e => console.error('❌ Still cannot play:', e));
        }, { once: true });
      });
    
    // Eventos de debug
    heroVideo.addEventListener('loadstart', () => console.log('📥 Video loadstart'));
    heroVideo.addEventListener('loadedmetadata', () => console.log('📊 Video metadata loaded'));
    heroVideo.addEventListener('loadeddata', () => console.log('📦 Video data loaded'));
    heroVideo.addEventListener('canplay', () => console.log('▶️ Video can play'));
    heroVideo.addEventListener('playing', () => console.log('🎬 Video is playing'));
    
    // 1. Pausar/reproducir según visibilidad del HERO (no del video)
    const heroSection = document.querySelector('.hero');
    if (heroSection) {
      const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            console.log('👁️ Hero section visible, playing video');
            heroVideo.play().catch(err => {
              console.log('❌ Video play prevented:', err);
            });
          } else {
            console.log('🙈 Hero section not visible, pausing video');
            heroVideo.pause();
          }
        });
      }, { threshold: 0.1 }); // Solo necesita 10% de visibilidad
      
      videoObserver.observe(heroSection);
    }
    
    // 2. Pausar video cuando la pestaña no está visible
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        heroVideo.pause();
      } else if (heroVideo.paused) {
        heroVideo.play().catch(err => console.log('❌ Video play prevented:', err));
      }
    });
    
    // 3. Manejar errores de carga del video
    heroVideo.addEventListener('error', (e) => {
      console.error('💥 Error cargando video:', e);
      console.error('💥 Error details:', heroVideo.error);
    });
  } else {
    console.error('❌ No se encontró el elemento de video');
  }
</script>
