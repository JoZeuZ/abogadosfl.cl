---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Mapa del Sitio - Abogados FL">
  <Header />
  
  <main class="sitemap-page">
    <div class="container">
      <div class="sitemap-content">
        <h1 class="sitemap-title">Mapa del Sitio</h1>
        <p class="sitemap-intro">
          Acceda rápidamente a todas las secciones de nuestro sitio web. A continuación, 
          encontrará enlaces organizados a todas las páginas disponibles.
        </p>

        <div class="sitemap-grid">
          <!-- Sección Principal -->
          <div class="sitemap-section">
            <h2 class="section-title">
              <i class="fas fa-home"></i>
              Página Principal
            </h2>
            <ul class="sitemap-links">
              <li>
                <a href="/">
                  <i class="fas fa-angle-right"></i>
                  Inicio
                </a>
              </li>
            </ul>
          </div>

          <!-- Secciones de la Página Principal -->
          <div class="sitemap-section">
            <h2 class="section-title">
              <i class="fas fa-th-large"></i>
              Secciones Principales
            </h2>
            <ul class="sitemap-links">
              <li>
                <a href="/#sobre-nosotros">
                  <i class="fas fa-angle-right"></i>
                  Sobre Nosotros
                </a>
              </li>
              <li>
                <a href="/#servicios">
                  <i class="fas fa-angle-right"></i>
                  Servicios Legales
                </a>
              </li>
              <li>
                <a href="/#equipo">
                  <i class="fas fa-angle-right"></i>
                  Nuestro Equipo
                </a>
              </li>
              <li>
                <a href="/#testimonios">
                  <i class="fas fa-angle-right"></i>
                  Testimonios
                </a>
              </li>
              <li>
                <a href="/#casos-exito">
                  <i class="fas fa-angle-right"></i>
                  Casos de Éxito
                </a>
              </li>
              <li>
                <a href="/#preguntas-frecuentes">
                  <i class="fas fa-angle-right"></i>
                  Preguntas Frecuentes
                </a>
              </li>
              <li>
                <a href="/#contacto">
                  <i class="fas fa-angle-right"></i>
                  Contacto
                </a>
              </li>
            </ul>
          </div>

          <!-- Áreas de Práctica -->
          <div class="sitemap-section">
            <h2 class="section-title">
              <i class="fas fa-balance-scale"></i>
              Áreas de Práctica
            </h2>
            <ul class="sitemap-links">
              <li>
                <a href="/#servicios">
                  <i class="fas fa-angle-right"></i>
                  Derecho Corporativo
                </a>
                <span class="service-desc">Contratos, constitución de empresas, fusiones</span>
              </li>
              <li>
                <a href="/#servicios">
                  <i class="fas fa-angle-right"></i>
                  Derecho Inmobiliario
                </a>
                <span class="service-desc">Compraventa, arriendos, hipotecas</span>
              </li>
              <li>
                <a href="/#servicios">
                  <i class="fas fa-angle-right"></i>
                  Derecho de Familia
                </a>
                <span class="service-desc">Divorcios, tuiciones, pensiones alimenticias</span>
              </li>
              <li>
                <a href="/#servicios">
                  <i class="fas fa-angle-right"></i>
                  Derecho Laboral
                </a>
                <span class="service-desc">Contratos laborales, despidos, negociaciones</span>
              </li>
              <li>
                <a href="/#servicios">
                  <i class="fas fa-angle-right"></i>
                  Derecho Penal
                </a>
                <span class="service-desc">Defensa penal, querellas, recursos</span>
              </li>
              <li>
                <a href="/#servicios">
                  <i class="fas fa-angle-right"></i>
                  Derecho Civil
                </a>
                <span class="service-desc">Contratos civiles, responsabilidad civil</span>
              </li>
            </ul>
          </div>

          <!-- Información Legal -->
          <div class="sitemap-section">
            <h2 class="section-title">
              <i class="fas fa-gavel"></i>
              Información Legal
            </h2>
            <ul class="sitemap-links">
              <li>
                <a href="/aviso-legal">
                  <i class="fas fa-angle-right"></i>
                  Aviso Legal
                </a>
              </li>
              <li>
                <a href="/politica-privacidad">
                  <i class="fas fa-angle-right"></i>
                  Política de Privacidad
                </a>
              </li>
              <li>
                <a href="/politica-cookies">
                  <i class="fas fa-angle-right"></i>
                  Política de Cookies
                </a>
              </li>
              <li>
                <a href="/terminos-condiciones">
                  <i class="fas fa-angle-right"></i>
                  Términos y Condiciones
                </a>
              </li>
            </ul>
          </div>

          <!-- Información de Contacto -->
          <div class="sitemap-section">
            <h2 class="section-title">
              <i class="fas fa-envelope"></i>
              Contacto
            </h2>
            <ul class="sitemap-links">
              <li>
                <a href="/#contacto">
                  <i class="fas fa-angle-right"></i>
                  Formulario de Contacto
                </a>
              </li>
              <li>
                <i class="fas fa-map-marker-alt"></i>
                <span class="contact-info">Valdivia #300 Oficina 505, Los Ángeles, Chile</span>
              </li>
              <li>
                <i class="fas fa-phone"></i>
                <span class="contact-info">+56 9 7319 8154</span>
              </li>
              <li>
                <i class="fas fa-envelope"></i>
                <a href="mailto:info@abogadosfl.cl" class="contact-link">info@abogadosfl.cl</a>
              </li>
            </ul>
          </div>

          <!-- Redes Sociales -->
          <div class="sitemap-section">
            <h2 class="section-title">
              <i class="fas fa-share-alt"></i>
              Redes Sociales
            </h2>
            <ul class="sitemap-links">
              <li>
                <a href="#" target="_blank" rel="noopener">
                  <i class="fab fa-facebook-f"></i>
                  Facebook
                </a>
              </li>
              <li>
                <a href="#" target="_blank" rel="noopener">
                  <i class="fab fa-linkedin-in"></i>
                  LinkedIn
                </a>
              </li>
              <li>
                <a href="#" target="_blank" rel="noopener">
                  <i class="fab fa-twitter"></i>
                  Twitter
                </a>
              </li>
              <li>
                <a href="#" target="_blank" rel="noopener">
                  <i class="fab fa-instagram"></i>
                  Instagram
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="sitemap-footer">
          <p>
            <i class="fas fa-info-circle"></i>
            Si tiene problemas para encontrar algo o necesita asistencia, no dude en 
            <a href="/#contacto">contactarnos</a>.
          </p>
        </div>

        <div class="legal-actions">
          <a href="/" class="btn-primary">Volver al Inicio</a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .sitemap-page {
    padding: 120px 0 80px;
    background: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%);
    min-height: 100vh;
  }

  .sitemap-content {
    max-width: 1200px;
    margin: 0 auto;
    background: white;
    padding: 60px;
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
  }

  .sitemap-title {
    font-size: 2.5rem;
    color: var(--color-primary);
    margin-bottom: 1rem;
    text-align: center;
  }

  .sitemap-intro {
    text-align: center;
    font-size: 1.1rem;
    color: var(--color-text);
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 3px solid var(--color-accent);
  }

  .sitemap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .sitemap-section {
    background: #f8f9fa;
    padding: 2rem;
    border-radius: 8px;
    border-left: 4px solid var(--color-accent);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .sitemap-section:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .section-title {
    font-size: 1.3rem;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .section-title i {
    color: var(--color-accent);
    font-size: 1.2rem;
  }

  .sitemap-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sitemap-links li {
    margin-bottom: 1rem;
    padding-left: 0;
  }

  .sitemap-links li a {
    color: var(--color-text);
    text-decoration: none;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    transition: color 0.3s ease;
    font-weight: 500;
  }

  .sitemap-links li a:hover {
    color: var(--color-accent);
  }

  .sitemap-links li a i.fas.fa-angle-right,
  .sitemap-links li a i.fab {
    color: var(--color-accent);
    margin-top: 3px;
    flex-shrink: 0;
  }

  .sitemap-links li i.fas:not(.fa-angle-right) {
    color: var(--color-accent);
    margin-top: 3px;
    flex-shrink: 0;
    margin-right: 0.5rem;
  }

  .service-desc {
    display: block;
    font-size: 0.85rem;
    color: #666;
    margin-top: 0.3rem;
    margin-left: 1.5rem;
  }

  .contact-info {
    color: var(--color-text);
    font-size: 0.95rem;
  }

  .contact-link {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .contact-link:hover {
    text-decoration: underline;
  }

  .sitemap-footer {
    background: linear-gradient(135deg, var(--color-primary) 0%, #2a3d50 100%);
    color: white;
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
    margin: 2rem 0;
  }

  .sitemap-footer p {
    margin: 0;
    font-size: 1rem;
  }

  .sitemap-footer i {
    color: var(--color-accent);
    margin-right: 0.5rem;
  }

  .sitemap-footer a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .sitemap-footer a:hover {
    text-decoration: underline;
  }

  .legal-actions {
    display: flex;
    gap: 1rem;
    margin-top: 3rem;
    justify-content: center;
  }

  .btn-primary {
    padding: 12px 30px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: background-color 1.2s ease,
                transform 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 1.2s ease,
                color 1.2s ease;
    will-change: transform;
    background: var(--color-accent);
    color: white;
  }

  .btn-primary:hover {
    background: #c69635;
    transform: translateY(-2px) translateZ(0);
    box-shadow: 0 5px 15px rgba(218, 165, 32, 0.3);
  }

  @media (max-width: 768px) {
    .sitemap-page {
      padding: 100px 0 60px;
    }

    .sitemap-content {
      padding: 30px 20px;
    }

    .sitemap-title {
      font-size: 2rem;
    }

    .sitemap-intro {
      font-size: 1rem;
    }

    .sitemap-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .sitemap-section {
      padding: 1.5rem;
    }

    .section-title {
      font-size: 1.1rem;
    }

    .sitemap-footer {
      padding: 1rem;
      font-size: 0.9rem;
    }
  }
</style>
